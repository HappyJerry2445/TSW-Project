<configuration>
    <!-- This appender logs to the console (which will appear in IntelliJ) -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{YYYY-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Set the root logging level. Use DEBUG for development. -->
    <root level="DEBUG">
        <appender-ref ref="STDOUT" />
    </root>

    <!-- You can also set levels for specific packages -->
    <logger name="com.cardhaven.cardhaven" level="DEBUG" />
</configuration>