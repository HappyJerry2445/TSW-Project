<?xml version="1.0" encoding="UTF-8" ?>
<taglib
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://java.sun.com/xml/ns/javaee"
        xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-jsptaglibrary_2_1.xsd"
        version="2.1">

    <tlib-version>1.0</tlib-version>
    <short-name>my-functions</short-name>
    <uri>/WEB-INF/functions</uri>
    <function>
        <name>formatDateTime</name>
        <function-class>com.cardhaven.cardhaven.util.DateTimeFormatterUtil</function-class>
        <function-signature>java.lang.String formatLocalDateTime(java.time.LocalDateTime)</function-signature>
    </function>
    <function>
        <name>formatDateTimePattern</name>
        <function-class>com.cardhaven.cardhaven.util.DateTimeFormatterUtil</function-class>
        <function-signature>java.lang.String formatLocalDateTime(java.time.LocalDateTime, java.lang.String)
        </function-signature>
    </function>
    <function>
        <name>capitalize</name>
        <function-class>com.cardhaven.cardhaven.util.DateTimeFormatterUtil</function-class>
        <function-signature>java.lang.String capitalizeFirstLetter(java.lang.String)</function-signature>
    </function>
</taglib>